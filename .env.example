# Template de .env para deployment
# Copia este archivo a .env y completa tus valores
# ⚠️ NUNCA commits .env a Git - agrégalo a .gitignore

# === WALLET ===
# Tu private key (SIN "0x" si lo necesita)
# Obtener de Metamask: Settings > Account Details > Export Private Key
PRIVATE_KEY=0x...

# === RPC ENDPOINTS ===
# Compatible con Foundry

# Sepolia Testnet (Recomendado para Uniswap v4)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Arbitrum Sepolia
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optimism Sepolia  
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io

# Base Sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Local Anvil
ANVIL_RPC_URL=http://localhost:8545

# === ETHERSCAN API (para verificación automática) ===
# Obtener de: https://etherscan.io -> Account -> API Keys

# Sepolia Etherscan API Key
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Arbitrum Arbiscan API Key
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY

# Optimism Etherscan API Key
OPTIMISM_ETHERSCAN_API_KEY=YOUR_OPTIMISM_ETHERSCAN_API_KEY

# === BROADCAST SOURCE (Dónde guardar los tx) ===
# Broadcast directory
BROADCAST_DIR=broadcast

# === OPCIONALES ===
# Token addresses en testnet (si aplica)
WETH_ADDRESS=0x...
BRASIL_TOKEN_ADDRESS=0x...
POOL_MANAGER_ADDRESS=0x...
